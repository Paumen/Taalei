@charset "utf-8";

:root { --itchio_ui_bg: #5b5b5b; }

body { background-color: rgb(255, 255, 255); }

.user_page {
  --itchio_font_family: Lato; --itchio_link_color: #dd4a4a; --itchio_gray_back: #f2f2f2; --itchio_border_radius: 0px; color: rgb(34, 34, 34); font-size: 100%; font-family: Lato, Lato, LatoExtended, sans-serif;
  & hr { background-color: rgb(216, 216, 216); }
  & .user_links .svgicon { fill: rgb(34, 34, 34); }
  & .game_column, & .purchased_games, & .collection_row { border-color: rgb(216, 216, 216); }
}

.user_page_wrap { }

.header .image_header img { }

.user_page a, .footer a { color: rgb(221, 74, 74); }

.footer { border-color: rgb(216, 216, 216); }

.game_grid_widget .game_cell {
  & .game_thumb, & .gif_overlay { border-radius: 0px; }
  & .game_title a.title { color: rgb(221, 74, 74); }
  & .web_flag { color: rgb(34, 34, 34); background: rgb(216, 216, 216); }
  & .game_text, & .game_author { color: rgba(34, 34, 34, 0.75); }
  & .game_platform, & .game_genre { color: rgba(34, 34, 34, 0.5); }
}
